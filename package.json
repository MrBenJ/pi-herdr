{
  "name": "pi-herdr",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./src/orchestrator/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "docs/compatibility.md",
    "docs/tool-contract.md",
    "docs/manual-smoke.md",
    "docs/release-checklist.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cli": "HERDR_CLI_CONTRACT=1 vitest run tests/cli-contract.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "26.5.0",
    "typebox": "1.3.7",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
